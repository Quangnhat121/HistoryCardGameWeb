{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/server.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/server/health" },
    { "source": "/api/:path*", "destination": "/api/server/api/:path*" },
    { "source": "/socket.io/:path*", "destination": "/api/server/socket.io/:path*" }
  ]
}
